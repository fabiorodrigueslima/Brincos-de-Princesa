{
  "name": "brinco-de-princesa",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend --prefix-colors magenta,cyan \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "db:status": "npm run db:status --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed:dev": "npm run db:seed:dev --workspace backend",
    "admin:create": "npm run admin:create --workspace backend",
    "jobs:expire-orders": "npm run jobs:expire-orders --workspace backend",
    "jobs:send-emails": "npm run jobs:send-emails --workspace backend",
    "setup:check": "npm run setup:check --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": { "node": ">=22.0.0" }
}
