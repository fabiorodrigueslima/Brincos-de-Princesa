{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env src/scripts/checkDatabase.js",
    "db:status": "node --env-file-if-exists=.env src/scripts/checkDatabase.js",
    "db:migrate": "node --env-file-if-exists=.env src/scripts/runMigrations.js",
    "db:seed:dev": "node --env-file-if-exists=.env src/scripts/runDevelopmentSeed.js",
    "admin:create": "node --env-file-if-exists=.env src/scripts/createAdmin.js",
    "jobs:expire-orders": "node --env-file-if-exists=.env src/scripts/expireOrders.js",
    "jobs:send-emails": "node --env-file-if-exists=.env src/scripts/sendEmails.js",
    "setup:check": "node --env-file-if-exists=.env src/scripts/setupCheck.js",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:postgres",
    "test:unit": "vitest run --exclude tests/*-postgres.integration.test.js",
    "test:postgres": "node --env-file-if-exists=.env tests/run-postgres-integration.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=22.0.0" }
}
