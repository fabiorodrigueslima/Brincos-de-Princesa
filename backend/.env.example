# Development only. Production requirements are documented in DEPLOY.md.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=0
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3000

# Runtime user, never the migration owner. Use TLS and pooled URL in the cloud.
DATABASE_URL=postgresql://brinco_app:CHANGEME@localhost:5432/brinco_de_princesa
DB_SSL=false
DB_POOL_MAX=3
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000
# Only in a deliberate release process, not in the Vercel API runtime:
# DATABASE_ADMIN_URL=postgresql://migration_user:CHANGEME@localhost:5432/brinco_de_princesa
# ALLOW_REMOTE_MIGRATION_DATABASE=true
# ALLOW_DIFFERENT_DATABASE_ENDPOINTS=true
# Tests must use explicit isolated credentials; the test runner never loads .env.
# TEST_DATABASE_URL=postgresql://brinco_app:TEST_ONLY@localhost:55439/brinco_de_princesa_test
# TEST_DATABASE_ADMIN_URL=postgresql://test_admin:ADMIN_TEST_ONLY@localhost:55439/postgres
# ALLOW_REMOTE_TEST_DATABASE=false

PAYMENT_PROVIDER=disabled
# Production requires mercado-pago and these credentials:
# MERCADO_PAGO_ACCESS_TOKEN=CHANGEME
# MERCADO_PAGO_WEBHOOK_SECRET=CHANGEME_WITH_RANDOM_SECRET
MERCADO_PAGO_API_URL=https://api.mercadopago.com
WEBHOOK_MAX_AGE_SECONDS=600

SHIPPING_PROVIDER=configurable
SHIPPING_FIXED_PRICE=0.00
SHIPPING_FREE_ABOVE=
SHIPPING_ESTIMATED_DAYS=7
SHIPPING_ALLOWED_STATES=
SHIPPING_LOCAL_PICKUP=false
SHIPPING_LOCAL_PICKUP_LABEL=Retirada no ateliê
# Production requires superfrete and an explicit NON-sandbox HTTPS endpoint.
SUPERFRETE_API_BASE_URL=https://sandbox.superfrete.com/api/v0
# SUPERFRETE_TOKEN=CHANGEME
# SUPERFRETE_ORIGIN_CEP=01001000
SUPERFRETE_SERVICES=1,2
POSTAL_CODE_PROVIDER_URL=https://brasilapi.com.br/api/cep/v2
EXTERNAL_REQUEST_TIMEOUT_MS=4000

STORAGE_PROVIDER=disabled
# Production requires cloudinary:
# CLOUDINARY_CLOUD_NAME=CHANGEME
# CLOUDINARY_API_KEY=CHANGEME
# CLOUDINARY_API_SECRET=CHANGEME
CLOUDINARY_FOLDER=brinco-de-princesa/products
# Alternative development storage only:
# STORAGE_HTTP_URL=https://storage.example.com/objects
# STORAGE_HTTP_TOKEN=CHANGEME
# STORAGE_PUBLIC_URL=https://cdn.example.com

EMAIL_PROVIDER=disabled
# Production requires http and the four templates listed in DEPLOY.md.
# EMAIL_WEBHOOK_URL=https://mail.example.com/send
# EMAIL_WEBHOOK_TOKEN=CHANGEME

CUSTOMER_SESSION_HOURS=168
ADMIN_SESSION_HOURS=8
# memory only for development/tests; production uses postgres automatically.
RATE_LIMIT_STORE=memory
# Required in production; use a random value of at least 32 characters.
# CRON_SECRET=CHANGEME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# VERCEL is supplied automatically by Vercel. Do not set it locally.
# VERCEL_ENV is also supplied automatically. Only preview permits sandbox URLs.

# Use catalog para publicar catálogo e painel sem compras ou integrações.
SITE_MODE=commerce
