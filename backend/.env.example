NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=0
DATABASE_URL=postgresql://brinco_app:CHANGE_ME_RUNTIME@localhost:5432/brinco_de_princesa
# Runtime e administração devem usar credenciais diferentes.
# Mantenha os valores reais somente no .env ignorado ou no secret manager do CI.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME_ADMIN@localhost:5432/brinco_de_princesa
TEST_DATABASE_URL=postgresql://brinco_app:CHANGE_ME_RUNTIME@localhost:5432/brinco_de_princesa_test
TEST_DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME_ADMIN@localhost:5432/postgres
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=3000
# SHIPPING
# Use 'configurable' em desenvolvimento/testes e 'superfrete' em produção.
SHIPPING_PROVIDER=configurable
SHIPPING_FIXED_PRICE=0.00
SHIPPING_FREE_ABOVE=
SHIPPING_ESTIMATED_DAYS=7
SHIPPING_ALLOWED_STATES=
SHIPPING_LOCAL_PICKUP=false
SHIPPING_LOCAL_PICKUP_LABEL=Retirada no ateliê

# SuperFrete - token somente no ambiente/secret manager.
SUPERFRETE_API_BASE_URL=https://sandbox.superfrete.com/api/v0
SUPERFRETE_TOKEN=
SUPERFRETE_ORIGIN_CEP=
SUPERFRETE_SERVICES=1,2

# PAYMENT
PAYMENT_PROVIDER=disabled
# Use mercado-pago somente depois de preencher os segredos no ambiente/secret manager.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Mantidos somente para uma futura integração com SDK frontend ou OAuth.
# O Checkout Pro atual não utiliza estes três valores.
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_API_URL=https://api.mercadopago.com
PUBLIC_BACKEND_URL=https://api.seudominio.com.br
PUBLIC_FRONTEND_URL=https://www.seudominio.com.br

# AUTH
CUSTOMER_SESSION_HOURS=168
ADMIN_SESSION_HOURS=8

# EMAIL
EMAIL_PROVIDER=disabled
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# STORAGE
# Em produção, use somente cloudinary e preencha as três variáveis abaixo.
# Em desenvolvimento/testes, local ou disabled continuam permitidos.
STORAGE_PROVIDER=cloudinary
STORAGE_HTTP_URL=
STORAGE_HTTP_TOKEN=
STORAGE_PUBLIC_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=brinco-de-princesa/products

# OBSERVABILITY
# A aplicação escreve logs JSON em stdout; configure coleta e alertas na hospedagem.
